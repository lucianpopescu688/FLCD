%{
/*
 * Laboratory 6 - Yacc/Bison Parser
 * Language: Cloud Infrastructure DSL
 *
 * Each semantic action records/prints the production index (1..107)
 * applied during LALR(1) reduction, producing the derivation sequence.
 *
 * Supports two input modes:
 *   1. Standard Lex+Yacc mode: Scans source code via Flex, generating
 *      PIF (Program Internal Form) and Symbol Table (ST) while parsing.
 *   2. PIF mode (--pif <pif_file>): Reads token stream directly from
 *      an existing PIF file generated by the scanner.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "st.h"

int yylex(void);
void yyerror(const char *s);

extern int line_num;
extern FILE *yyin;
extern SymbolTable sym_table;
extern PIF pif_table;

/* Output file pointer for production indices */
FILE *prod_fp = NULL;

/* Dual-mode support */
int pif_mode = 0;
FILE *pif_in = NULL;
extern int flex_yylex(void);
int pif_yylex(void);

static void emit(int prodnum) {
    if (prod_fp) fprintf(prod_fp, "%d ", prodnum);
    printf("%d ", prodnum);
}
%}

/* ------------------------------------------------------------------ */
/*  Token declarations — aligned with scanner.lxi and token1.in.txt   */
/* ------------------------------------------------------------------ */

/* Type keywords */
%token INT_T STRING_T BOOLEAN_T PROCESS_T STATE_T GROUP_T IP_ADDRESS_T

/* Control-flow keywords */
%token DEPENDS_ON IF ELSE SWITCH CASE DEFAULT WHILE FOR
%token BREAK CONTINUE TRY CATCH

/* Built-in function keywords */
%token WAIT_SECONDS
%token PING_SERVER SPIN_UP_INSTANCE KILL_INSTANCE LOG_ALERT
%token START STOP RESTART ENABLE DISABLE
%token STATUS AUTOSTART

/* Logical operators (keywords) */
%token AND OR NOT

/* Boolean and state constant keywords */
%token TRUE_T FALSE_T
%token RUNNING_T STOPPED_T ERROR_T

/* Multi-character operators */
%token EQ NE LE GE

/* Identifiers and constants */
%token ID NUMBER STRING_CONST

%%

/* ------------------------------------------------------------------ */
/*  Grammar Productions (strictly numbered 1 .. 107)                 */
/* ------------------------------------------------------------------ */

/* 1 */
program
    : statements_list                                            { emit(1); }
    ;

/* 2 - 3 */
statements_list
    : statement                                                  { emit(2); }
    | statements_list statement                                  { emit(3); }
    ;

/* 4 - 15 */
statement
    : declaration_statement                                      { emit(4); }
    | assign_statement                                           { emit(5); }
    | io_statement                                               { emit(6); }
    | process_statement                                          { emit(7); }
    | if_statement                                               { emit(8); }
    | switch_statement                                           { emit(9); }
    | while_statement                                            { emit(10); }
    | for_statement                                              { emit(11); }
    | try_statement                                              { emit(12); }
    | break_statement                                            { emit(13); }
    | continue_statement                                         { emit(14); }
    | wait_statement                                             { emit(15); }
    ;

/* 16 - 24 */
declaration_statement
    : type ID ';'                                                { emit(16); }
    | type ID '=' expression ';'                                 { emit(17); }
    | PROCESS_T ID ';'                                           { emit(18); }
    | PROCESS_T ID '{' DEPENDS_ON ':' identifier_list '}' ';'    { emit(19); }
    | GROUP_T ID '=' '[' identifier_list ']' ';'                 { emit(20); }
    | PROCESS_T '[' NUMBER ']' ID ';'                            { emit(21); }
    | PROCESS_T '[' NUMBER ']' ID '=' expression ';'             { emit(22); }
    | GROUP_T '[' NUMBER ']' ID ';'                              { emit(23); }
    | GROUP_T '[' NUMBER ']' ID '=' expression ';'               { emit(24); }
    ;

/* 25 - 26 */
identifier_list
    : ID                                                         { emit(25); }
    | identifier_list ',' ID                                     { emit(26); }
    ;

/* 27 - 28 */
assign_statement
    : ID '=' expression ';'                                      { emit(27); }
    | ID '[' expression ']' '=' expression ';'                   { emit(28); }
    ;

/* 29 - 30 */
assign_statement_nosemi
    : ID '=' expression                                          { emit(29); }
    | ID '[' expression ']' '=' expression                       { emit(30); }
    ;

/* 31 */
io_statement
    : io_reserved_word '(' expression ')' ';'                    { emit(31); }
    ;

/* 32 */
process_statement
    : process_reserved_word '(' expression ')' ';'               { emit(32); }
    ;

/* 33 */
wait_statement
    : WAIT_SECONDS '(' expression ')' ';'                        { emit(33); }
    ;

/* 34 */
if_statement
    : IF '(' condition ')' '{' statements_list '}' else_branch   { emit(34); }
    ;

/* 35 - 36 */
else_branch
    : ELSE '{' statements_list '}'                               { emit(35); }
    | /* empty */                                                { emit(36); }
    ;

/* 37 */
switch_statement
    : SWITCH '(' expression ')' '{' case_list default_case '}'   { emit(37); }
    ;

/* 38 - 39 */
case_list
    : case_statement                                             { emit(38); }
    | case_list case_statement                                   { emit(39); }
    ;

/* 40 */
case_statement
    : CASE constant ':' statements_list BREAK ';'                { emit(40); }
    ;

/* 41 - 42 */
default_case
    : DEFAULT ':' statements_list                                { emit(41); }
    | /* empty */                                                { emit(42); }
    ;

/* 43 */
while_statement
    : WHILE '(' condition ')' '{' statements_list '}'            { emit(43); }
    ;

/* 44 */
for_statement
    : FOR '(' for_init condition ';' assign_statement_nosemi ')' '{' statements_list '}' { emit(44); }
    ;

/* 45 - 46 */
for_init
    : declaration_statement                                      { emit(45); }
    | assign_statement                                           { emit(46); }
    ;

/* 47 */
break_statement
    : BREAK ';'                                                  { emit(47); }
    ;

/* 48 */
continue_statement
    : CONTINUE ';'                                               { emit(48); }
    ;

/* 49 */
try_statement
    : TRY '{' statements_list '}' CATCH '{' statements_list '}'  { emit(49); }
    ;

/* 50 - 51 */
condition
    : simple_condition                                           { emit(50); }
    | condition logical_operator simple_condition                { emit(51); }
    ;

/* 52 - 54 */
simple_condition
    : expression relation expression                             { emit(52); }
    | NOT '(' condition ')'                                      { emit(53); }
    | '(' condition ')'                                          { emit(54); }
    ;

/* 55 - 56 */
expression
    : multiplicative_expr                                        { emit(55); }
    | expression add_op multiplicative_expr                      { emit(56); }
    ;

/* 57 - 58 */
multiplicative_expr
    : term                                                       { emit(57); }
    | multiplicative_expr mul_op term                            { emit(58); }
    ;

/* 59 - 66 */
term
    : ID                                                         { emit(59); }
    | ID '[' expression ']'                                      { emit(60); }
    | NUMBER                                                     { emit(61); }
    | STRING_CONST                                               { emit(62); }
    | boolean_constant                                           { emit(63); }
    | state_constant                                             { emit(64); }
    | builtin_call                                               { emit(65); }
    | '(' expression ')'                                         { emit(66); }
    ;

/* 67 */
builtin_call
    : builtin_reserved_word '(' expression ')'                   { emit(67); }
    ;

/* 68 - 69 */
type
    : simple_type                                                { emit(68); }
    | simple_type '[' NUMBER ']'                                 { emit(69); }
    ;

/* 70 - 74 */
simple_type
    : INT_T                                                      { emit(70); }
    | STRING_T                                                   { emit(71); }
    | BOOLEAN_T                                                  { emit(72); }
    | STATE_T                                                    { emit(73); }
    | IP_ADDRESS_T                                               { emit(74); }
    ;

/* 75 - 78 */
constant
    : NUMBER                                                     { emit(75); }
    | STRING_CONST                                               { emit(76); }
    | boolean_constant                                           { emit(77); }
    | state_constant                                             { emit(78); }
    ;

/* 79 - 80 */
boolean_constant
    : TRUE_T                                                     { emit(79); }
    | FALSE_T                                                    { emit(80); }
    ;

/* 81 - 83 */
state_constant
    : RUNNING_T                                                  { emit(81); }
    | STOPPED_T                                                  { emit(82); }
    | ERROR_T                                                    { emit(83); }
    ;

/* 84 - 87 */
io_reserved_word
    : PING_SERVER                                                { emit(84); }
    | SPIN_UP_INSTANCE                                           { emit(85); }
    | KILL_INSTANCE                                              { emit(86); }
    | LOG_ALERT                                                  { emit(87); }
    ;

/* 88 - 92 */
process_reserved_word
    : START                                                      { emit(88); }
    | STOP                                                       { emit(89); }
    | RESTART                                                    { emit(90); }
    | ENABLE                                                     { emit(91); }
    | DISABLE                                                    { emit(92); }
    ;

/* 93 - 94 */
builtin_reserved_word
    : STATUS                                                     { emit(93); }
    | AUTOSTART                                                  { emit(94); }
    ;

/* 95 - 96 */
add_op
    : '+'                                                        { emit(95); }
    | '-'                                                        { emit(96); }
    ;

/* 97 - 99 */
mul_op
    : '*'                                                        { emit(97); }
    | '/'                                                        { emit(98); }
    | '%'                                                        { emit(99); }
    ;

/* 100 - 105 */
relation
    : EQ                                                         { emit(100); }
    | NE                                                         { emit(101); }
    | '<'                                                        { emit(102); }
    | LE                                                         { emit(103); }
    | '>'                                                        { emit(104); }
    | GE                                                         { emit(105); }
    ;

/* 106 - 107 */
logical_operator
    : AND                                                        { emit(106); }
    | OR                                                         { emit(107); }
    ;

%%

void yyerror(const char *s)
{
    fprintf(stderr, "Parse error at line %d: %s\n", line_num, s);
}

/* ------------------------------------------------------------------ */
/*  PIF File Lexer: reads tokens line-by-line from a PIF table        */
/* ------------------------------------------------------------------ */
static char *trim_str(char *s) {
    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
    if (*s == '\0') return s;
    char *end = s + strlen(s) - 1;
    while (end > s && (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')) {
        *end = '\0';
        end--;
    }
    return s;
}

int pif_yylex(void) {
    char buf[1024];
    while (fgets(buf, sizeof(buf), pif_in)) {
        /* Skip comment/separator/header lines */
        if (buf[0] == '=' || buf[0] == '-' || strstr(buf, "Line") || strstr(buf, "Total Tokens"))
            continue;

        /* PIF line structure: Line | Token | ST_Pos | Matched Lexeme */
        char *p1 = strchr(buf, '|');
        if (!p1) continue;
        char *p2 = strchr(p1 + 1, '|');
        if (!p2) continue;
        char *p3 = strchr(p2 + 1, '|');
        if (!p3) continue;

        *p1 = '\0';
        *p2 = '\0';
        *p3 = '\0';

        char *line_s   = trim_str(buf);
        char *token_s  = trim_str(p1 + 1);
        char *lexeme_s = trim_str(p3 + 1);

        if (line_s[0] != '\0') {
            line_num = atoi(line_s);
        }

        /* Identifier */
        if (strcmp(token_s, "id") == 0) return ID;

        /* Constants */
        if (strcmp(token_s, "const") == 0) {
            if (strcmp(lexeme_s, "true") == 0) return TRUE_T;
            if (strcmp(lexeme_s, "false") == 0) return FALSE_T;
            if (strcmp(lexeme_s, "RUNNING") == 0) return RUNNING_T;
            if (strcmp(lexeme_s, "STOPPED") == 0) return STOPPED_T;
            if (strcmp(lexeme_s, "ERROR") == 0) return ERROR_T;
            if (lexeme_s[0] == '"') return STRING_CONST;
            return NUMBER;
        }

        /* Type keywords */
        if (strcmp(token_s, "int") == 0) return INT_T;
        if (strcmp(token_s, "string") == 0) return STRING_T;
        if (strcmp(token_s, "boolean") == 0) return BOOLEAN_T;
        if (strcmp(token_s, "process") == 0) return PROCESS_T;
        if (strcmp(token_s, "state") == 0) return STATE_T;
        if (strcmp(token_s, "group") == 0) return GROUP_T;
        if (strcmp(token_s, "ip_address") == 0) return IP_ADDRESS_T;

        /* Control keywords */
        if (strcmp(token_s, "depends_on") == 0) return DEPENDS_ON;
        if (strcmp(token_s, "if") == 0) return IF;
        if (strcmp(token_s, "else") == 0) return ELSE;
        if (strcmp(token_s, "switch") == 0) return SWITCH;
        if (strcmp(token_s, "case") == 0) return CASE;
        if (strcmp(token_s, "default") == 0) return DEFAULT;
        if (strcmp(token_s, "while") == 0) return WHILE;
        if (strcmp(token_s, "for") == 0) return FOR;
        if (strcmp(token_s, "break") == 0) return BREAK;
        if (strcmp(token_s, "continue") == 0) return CONTINUE;
        if (strcmp(token_s, "try") == 0) return TRY;
        if (strcmp(token_s, "catch") == 0) return CATCH;
        if (strcmp(token_s, "wait_seconds") == 0) return WAIT_SECONDS;

        /* Built-in functions */
        if (strcmp(token_s, "ping_server") == 0) return PING_SERVER;
        if (strcmp(token_s, "spin_up_instance") == 0) return SPIN_UP_INSTANCE;
        if (strcmp(token_s, "kill_instance") == 0) return KILL_INSTANCE;
        if (strcmp(token_s, "log_alert") == 0) return LOG_ALERT;
        if (strcmp(token_s, "start") == 0) return START;
        if (strcmp(token_s, "stop") == 0) return STOP;
        if (strcmp(token_s, "restart") == 0) return RESTART;
        if (strcmp(token_s, "enable") == 0) return ENABLE;
        if (strcmp(token_s, "disable") == 0) return DISABLE;
        if (strcmp(token_s, "status") == 0) return STATUS;
        if (strcmp(token_s, "autostart") == 0) return AUTOSTART;

        /* Logical operators */
        if (strcmp(token_s, "and") == 0) return AND;
        if (strcmp(token_s, "or") == 0) return OR;
        if (strcmp(token_s, "not") == 0) return NOT;

        /* Relational operators */
        if (strcmp(token_s, "==") == 0) return EQ;
        if (strcmp(token_s, "!=") == 0) return NE;
        if (strcmp(token_s, "<=") == 0) return LE;
        if (strcmp(token_s, ">=") == 0) return GE;

        /* Single character operators & separators */
        if (strlen(token_s) == 1) {
            return (unsigned char)token_s[0];
        }
    }
    return 0; /* EOF */
}

/* yylex dispatcher */
int yylex(void) {
    if (pif_mode) {
        return pif_yylex();
    }
    return flex_yylex();
}

/* ------------------------------------------------------------------ */
/*  Main Entry Point                                                  */
/* ------------------------------------------------------------------ */
int main(int argc, char **argv)
{
    const char *input_file = NULL;
    const char *prod_file  = "productions.out";
    const char *pif_file   = "PIF.out";
    const char *st_file    = "ST.out";

    int pos_arg = 0;
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--pif") == 0 || strcmp(argv[i], "-p") == 0) {
            pif_mode = 1;
        } else {
            if (pos_arg == 0) {
                input_file = argv[i];
                pos_arg++;
            } else if (pos_arg == 1) {
                prod_file = argv[i];
                pos_arg++;
            } else if (pos_arg == 2) {
                pif_file = argv[i];
                pos_arg++;
            } else if (pos_arg == 3) {
                st_file = argv[i];
                pos_arg++;
            }
        }
    }

    if (!input_file) {
        input_file = pif_mode ? "PIF.out" : "program1.cloud.txt";
    }

    FILE *in_fp = fopen(input_file, "r");
    if (!in_fp) {
        fprintf(stderr, "Error: Cannot open input file '%s'\n", input_file);
        return 1;
    }

    prod_fp = fopen(prod_file, "w");
    if (!prod_fp) {
        fprintf(stderr, "Error: Cannot open output productions file '%s'\n", prod_file);
        fclose(in_fp);
        return 1;
    }

    if (pif_mode) {
        pif_in = in_fp;
        printf("Parsing from PIF input: '%s' ...\n", input_file);
    } else {
        yyin = in_fp;
        st_init(&sym_table);
        pif_init(&pif_table);
        printf("Parsing source program: '%s' (Lex + Yacc) ...\n", input_file);
    }

    int result = yyparse();
    printf("\n");

    fprintf(prod_fp, "\n");
    fclose(prod_fp);
    fclose(in_fp);

    /* In Lex mode, persist the generated PIF and ST files */
    if (!pif_mode) {
        pif_write_file(&pif_table, pif_file);
        st_write_file(&sym_table, st_file);
    }

    if (result == 0) {
        printf("Parsing completed successfully (0 syntax errors).\n");
        printf("Production sequence saved to '%s'.\n", prod_file);
        if (!pif_mode) {
            printf("Generated PIF: '%s' (%d tokens), ST: '%s' (%d symbols).\n",
                   pif_file, pif_table.count, st_file, sym_table.count);
        }
    } else {
        printf("Parsing finished with syntax errors.\n");
    }

    return result;
}
